---
import type { Product } from "../data/products";
import { getCategory } from "../data/categories";
import CategoryIcon from "./icons/CategoryIcon.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = getCategory(product.categorySlug);

const priceFormatter = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });
---

<a
  href={`/shop/${product.slug}/`}
  class="group flex flex-col overflow-hidden rounded-lg border border-neutral-line bg-neutral-paper transition-all hover:-translate-y-0.5 hover:border-brand-red-500/40 hover:shadow-md"
  data-category={product.categorySlug}
>
  <div class="relative flex aspect-[4/3] items-center justify-center bg-neutral-surface">
    <CategoryIcon
      name={category?.icon ?? "tools"}
      class="h-16 w-16 text-brand-ink-700/25 transition-transform group-hover:scale-105"
    />
    {category && (
      <span class="absolute left-2.5 top-2.5 rounded bg-white/90 px-2 py-0.5 text-[11px] font-medium text-neutral-body shadow-sm">
        {category.name}
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <h3 class="text-sm font-semibold leading-snug text-neutral-ink group-hover:text-brand-red-600">
      {product.name}
    </h3>
    <p class="line-clamp-2 text-xs text-neutral-body/80">{product.description}</p>
    <div class="mt-auto pt-2 text-sm font-semibold text-brand-ink-800">
      {
        product.callForPrice ? (
          <span class="text-brand-red-600">Call for a quote</span>
        ) : (
          <>
            {priceFormatter.format(product.price)}
            <span class="ml-1 text-xs font-normal text-neutral-body/60">
              {product.priceUnit} {product.vatNote}
            </span>
          </>
        )
      }
    </div>
  </div>
</a>
