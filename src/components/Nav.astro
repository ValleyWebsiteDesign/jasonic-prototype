---
import { branches, site } from "../data/site";
import { navGroups } from "../data/navGroups";

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/").replace(/\/{2,}/g, "/");
const primaryBranch = branches[0];

function isGroupActive(slugs: string[]) {
  if (!currentPath.startsWith("/shop")) return false;
  const category = Astro.url.searchParams.get("category");
  if (!category) return false;
  return category.split(",").some((c) => slugs.includes(c));
}
---

<header class="sticky top-0 z-40 bg-neutral-paper shadow-sm">
  <!-- Promo strip -->
  <div class="bg-brand-red-500 text-white">
    <div class="container-page flex flex-wrap items-center justify-center gap-2 py-2 text-center text-xs font-semibold tracking-wide sm:text-sm">
      <span>Free local delivery on orders over £150&nbsp;+&nbsp;VAT</span>
      <span class="hidden text-white/70 sm:inline">·</span>
      <span class="hidden sm:inline">Independent &amp; family run since {site.foundedYear}</span>
    </div>
  </div>

  <!-- Main row: logo, search, quote/account/cart -->
  <div class="border-b border-neutral-line">
    <div class="container-page flex flex-wrap items-center gap-4 py-4">
      <a href="/" class="flex shrink-0 items-center gap-2.5 text-neutral-ink">
        <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-ink-900 text-base font-bold text-brand-red-400">
          J
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-display text-xl font-bold tracking-tight">Jasonic</span>
          <span class="text-[11px] font-medium uppercase tracking-wider text-neutral-body/70">Builders Merchants</span>
        </span>
      </a>

      <!-- Search: category select + text input + button -->
      <form action="/shop/" method="get" class="order-3 flex w-full min-w-0 flex-1 items-stretch sm:order-none sm:w-auto">
        <label for="nav-category" class="sr-only">Category</label>
        <select
          id="nav-category"
          name="category"
          class="hidden shrink-0 rounded-l-md border border-r-0 border-neutral-line bg-neutral-surface px-3 text-sm text-neutral-body focus:outline-none focus:ring-1 focus:ring-brand-red-500 md:block"
        >
          <option value="">All categories</option>
          {navGroups.map((group) => <option value={group.categorySlugs.join(",")}>{group.label}</option>)}
        </select>
        <label for="nav-search" class="sr-only">Search products</label>
        <input
          id="nav-search"
          type="search"
          name="q"
          placeholder="Search products…"
          class="w-full min-w-0 flex-1 border border-neutral-line px-3.5 py-2.5 text-sm text-neutral-ink placeholder:text-neutral-body/50 focus:outline-none focus:ring-1 focus:ring-brand-red-500 md:rounded-none md:border-l-0"
        />
        <button
          type="submit"
          aria-label="Search"
          class="flex shrink-0 items-center justify-center rounded-r-md bg-brand-ink-900 px-4 text-white transition-colors hover:bg-brand-ink-800"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </button>
      </form>

      <div class="ml-auto flex shrink-0 items-center gap-4 sm:ml-0">
        <a
          href={primaryBranch.phoneHref}
          class="hidden items-center gap-1.5 text-sm font-semibold text-neutral-ink hover:text-brand-red-600 lg:flex"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          {primaryBranch.phone}
        </a>

        <a
          href="/contact/"
          aria-label="My account (contact us to get set up)"
          class="flex flex-col items-center gap-0.5 text-neutral-ink hover:text-brand-red-600"
          title="Trade accounts — coming soon, contact us"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3.4" />
            <path d="M5 20c1.2-3.6 4-5.4 7-5.4s5.8 1.8 7 5.4" />
          </svg>
          <span class="hidden text-[10px] font-medium sm:block">Account</span>
        </a>

        <a
          href="/contact/"
          aria-label="Quote basket (get a quote)"
          class="relative flex flex-col items-center gap-0.5 text-neutral-ink hover:text-brand-red-600"
          title="Add items to your enquiry from any product page"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1" />
            <circle cx="19" cy="21" r="1" />
            <path d="M2.5 3h2l2.6 12.4a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L21 8H6" />
          </svg>
          <span class="absolute -right-1.5 -top-1.5 flex h-4 w-4 items-center justify-center rounded-full bg-brand-red-500 text-[10px] font-bold text-white">
            0
          </span>
          <span class="hidden text-[10px] font-medium sm:block">Quote</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Category nav -->
  <nav class="border-b border-neutral-line bg-brand-ink-950" aria-label="Product categories">
    <div class="container-page">
      <ul class="flex items-center gap-1 overflow-x-auto py-2 text-sm font-medium">
        {
          navGroups.map((group) => (
            <li class="shrink-0">
              <a
                href={`/shop/?category=${group.categorySlugs.join(",")}`}
                class:list={[
                  "block rounded px-3 py-1.5 whitespace-nowrap transition-colors",
                  isGroupActive(group.categorySlugs)
                    ? "bg-brand-red-500 text-white"
                    : "text-brand-ink-100 hover:bg-white/10 hover:text-white",
                ]}
              >
                {group.label}
              </a>
            </li>
          ))
        }
        <li class="ml-auto flex shrink-0 items-center gap-1">
          <a href="/about/" class="block rounded px-3 py-1.5 whitespace-nowrap text-brand-ink-100 transition-colors hover:bg-white/10 hover:text-white">
            About
          </a>
          <a href="/contact/" class="block rounded px-3 py-1.5 whitespace-nowrap text-brand-ink-100 transition-colors hover:bg-white/10 hover:text-white">
            Contact
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>
