---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, description, align = "left", class: className = "" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : "", className]}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-widest text-brand-amber-600">{eyebrow}</p>}
  <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-neutral-ink sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-relaxed text-neutral-body">{description}</p>}
</div>
