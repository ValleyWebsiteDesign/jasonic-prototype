---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import Button from "../components/Button.astro";
import { site, branches, valueProps } from "../data/site";

const milestones = [
  { year: "1988", text: "Jasonic opens its first branch in Merthyr Tydfil, trading as an independent builders merchant." },
  { year: "1990s–2000s", text: "Steady growth serving local trades people, self-builders and major house developers across South Wales." },
  { year: "Today", text: "Two branches — Merthyr Tydfil and Taffs Well — stocking 13 product departments from timber to UPVC." },
];
---

<BaseLayout title="About" description="Jasonic — independent, family-run builders merchants trading in South & Mid Wales since 1988.">
  <section class="border-b border-neutral-line bg-neutral-surface py-14">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeading
          eyebrow="About Jasonic"
          title={`Family run since ${site.foundedYear}`}
          description={site.strapline}
        />
      </div>
      <PhotoPlaceholder icon="concrete" tone="navy" label="Taffs Well branch" class="aspect-[4/3] w-full" />
    </div>
  </section>

  <section class="py-16">
    <div class="container-page max-w-3xl">
      <h2 class="font-display text-xl font-bold text-neutral-ink">Our story</h2>
      <p class="mt-4 text-base leading-relaxed text-neutral-body">
        Jasonic is a locally owned, family run business committed to serving the needs of local trades people and
        DIY enthusiasts alike. We pride ourselves on our expert knowledge, and our customer service is second to
        none — the same approach that's kept trade and public customers coming back since {site.foundedYear}.
      </p>
      <p class="mt-4 text-base leading-relaxed text-neutral-body">
        Our customers range from local builders to major house developers, and we also supply building products to
        facilities management companies, local authorities and the general public. If you can't find what you're
        looking for on the site, our branch teams can usually still source it.
      </p>

      <div class="mt-12 space-y-6 border-l border-neutral-line pl-6">
        {
          milestones.map((m) => (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-amber-600">{m.year}</p>
              <p class="mt-1 text-sm leading-relaxed text-neutral-body">{m.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-line bg-brand-navy-950 py-16 text-white">
    <div class="container-page">
      <h2 class="font-display text-xl font-bold">Why trade & DIY customers choose Jasonic</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        {
          valueProps.map((item) => (
            <div>
              <p class="font-display text-base font-semibold text-brand-amber-400">{item.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-brand-navy-100/70">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page">
      <SectionHeading eyebrow="Our branches" title="Come and see us" />
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {
          branches.map((branch) => (
            <div class="rounded-lg border border-neutral-line p-6">
              <h3 class="font-display text-lg font-semibold text-neutral-ink">{branch.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-body">{branch.addressLines.join(", ")}</p>
              <p class="mt-3 text-sm font-semibold text-brand-navy-800">{branch.phone}</p>
            </div>
          ))
        }
      </div>
      <Button href="/contact/" variant="primary" class="mt-8">Get in touch</Button>
    </div>
  </section>
</BaseLayout>
