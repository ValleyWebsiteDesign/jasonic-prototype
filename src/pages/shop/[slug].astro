---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ProductCard from "../../components/ProductCard.astro";
import CategoryIcon from "../../components/icons/CategoryIcon.astro";
import { products, getProductsByCategory } from "../../data/products";
import { getCategory } from "../../data/categories";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const category = getCategory(product.categorySlug);
const related = getProductsByCategory(product.categorySlug)
  .filter((p) => p.slug !== product.slug)
  .slice(0, 3);

const priceFormatter = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });
---

<BaseLayout title={product.name} description={product.description}>
  <div class="container-page py-6 text-sm text-neutral-body/70">
    <a href="/shop/" class="hover:text-brand-red-600">Shop</a>
    <span class="mx-1.5">/</span>
    {category && (
      <a href={`/shop/?category=${category.slug}`} class="hover:text-brand-red-600">
        {category.name}
      </a>
    )}
    <span class="mx-1.5">/</span>
    <span class="text-neutral-ink">{product.name}</span>
  </div>

  <section class="container-page grid gap-10 pb-16 lg:grid-cols-2">
    <div class="flex aspect-square items-center justify-center rounded-lg bg-neutral-surface">
      <CategoryIcon name={category?.icon ?? "tools"} class="h-28 w-28 text-brand-ink-700/25" />
    </div>

    <div>
      {category && (
        <a href={`/shop/?category=${category.slug}`} class="text-xs font-semibold uppercase tracking-wide text-brand-red-600">
          {category.name}
        </a>
      )}
      <h1 class="mt-2 font-display text-2xl font-bold tracking-tight text-neutral-ink sm:text-3xl">{product.name}</h1>
      <p class="mt-1 text-xs text-neutral-body/50">SKU {product.sku}</p>

      <p class="mt-5 text-2xl font-bold text-brand-ink-900">
        {
          product.callForPrice ? (
            <span class="text-brand-red-600">Call for a quote</span>
          ) : (
            <>
              {priceFormatter.format(product.price)}
              <span class="ml-1.5 text-sm font-normal text-neutral-body/60">{product.priceUnit} {product.vatNote}</span>
            </>
          )
        }
      </p>

      <p class="mt-5 max-w-lg text-base leading-relaxed text-neutral-body">{product.description}</p>

      {product.specs.length > 0 && (
        <dl class="mt-6 divide-y divide-neutral-line rounded-lg border border-neutral-line">
          {product.specs.map((spec) => (
            <div class="flex justify-between gap-4 px-4 py-2.5 text-sm">
              <dt class="text-neutral-body/70">{spec.label}</dt>
              <dd class="font-medium text-neutral-ink">{spec.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact/" variant="primary">
          {product.callForPrice ? "Request a quote" : "Enquire about this product"}
        </Button>
        <Button href="tel:01685723344" variant="ghost">Call Merthyr Tydfil branch</Button>
      </div>
      <p class="mt-4 text-xs text-neutral-body/50">
        This prototype doesn't take online orders — enquiries route to a branch, matching how Jasonic trades today.
      </p>
    </div>
  </section>

  {related.length > 0 && (
    <section class="border-t border-neutral-line bg-neutral-surface py-14">
      <div class="container-page">
        <h2 class="font-display text-xl font-bold text-neutral-ink">More from {category?.name}</h2>
        <div class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
