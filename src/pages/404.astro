---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Page not found">
  <section class="container-page flex flex-col items-center py-24 text-center">
    <p class="font-display text-6xl font-bold text-brand-ink-900">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-neutral-ink">Page not found</h1>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-neutral-body">
      That page doesn't exist — it might have moved, or the link's out of date. Try the shop, or head back home.
    </p>
    <div class="mt-8 flex gap-3">
      <Button href="/" variant="primary">Back to home</Button>
      <Button href="/shop/" variant="ghost">Browse products</Button>
    </div>
  </section>
</BaseLayout>
