---
// Minimal line-art icon set, one per product category. Deliberately
// simple/geometric rather than photographic — no external image
// dependency, no licensing risk, and it reads as an intentional design
// choice for the shop's category grid and filter chips.
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "timber" && (
      <>
        <rect x="2.5" y="5" width="19" height="3.2" rx="0.5" />
        <rect x="2.5" y="10.4" width="19" height="3.2" rx="0.5" />
        <rect x="2.5" y="15.8" width="13" height="3.2" rx="0.5" />
      </>
    )
  }
  {
    name === "aggregates" && (
      <>
        <circle cx="7" cy="15" r="2.6" />
        <circle cx="13" cy="17" r="1.9" />
        <circle cx="17.5" cy="12.5" r="2.3" />
        <circle cx="11" cy="9.5" r="1.6" />
      </>
    )
  }
  {
    name === "concrete" && (
      <>
        <rect x="2.5" y="4" width="8.2" height="8.2" />
        <rect x="13.3" y="4" width="8.2" height="8.2" />
        <rect x="2.5" y="12.2" width="8.2" height="8.2" />
        <rect x="13.3" y="12.2" width="8.2" height="8.2" />
      </>
    )
  }
  {
    name === "roofing" && (
      <>
        <path d="M2 12 12 3l10 9" />
        <path d="M4.5 10.5V21h15V10.5" />
        <path d="M9.5 21v-6h5v6" />
      </>
    )
  }
  {
    name === "insulation" && (
      <>
        <rect x="2.5" y="6" width="19" height="12" rx="2" />
        <path d="M6 6v12M10.3 6v12M14.6 6v12M18.9 6v12" />
      </>
    )
  }
  {
    name === "plaster" && (
      <>
        <path d="M4 20 18 6" />
        <rect x="15.5" y="3.5" width="5" height="5" rx="0.6" transform="rotate(45 18 6)" />
        <path d="M4 20l-1.2 3 3-1.2z" />
      </>
    )
  }
  {
    name === "doors" && (
      <>
        <rect x="5" y="2.5" width="14" height="19" rx="0.8" />
        <circle cx="14.5" cy="12" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "bathrooms" && (
      <>
        <path d="M3 12h18v2.5A5.5 5.5 0 0 1 15.5 20h-7A5.5 5.5 0 0 1 3 14.5z" />
        <path d="M6 12V6.5A2.5 2.5 0 0 1 8.5 4c1 0 1.8.5 2.2 1.3" />
        <path d="M8 20v1.5M14 20v1.5" />
      </>
    )
  }
  {
    name === "kitchens" && (
      <>
        <path d="M6 3v6a3 3 0 0 0 6 0V3" />
        <path d="M9 9v12" />
        <path d="M16 3s-1.5 2-1.5 5 1.5 3 1.5 3v10" />
      </>
    )
  }
  {
    name === "garden" && (
      <>
        <path d="M4.5 21V9M9 21V5M13.5 21v-9M18 21V7" />
        <path d="M2.5 21h19" />
      </>
    )
  }
  {
    name === "tools" && (
      <>
        <path d="M14.7 6.3a4 4 0 0 0-5.4 4.9l-6 6 2 2 6-6a4 4 0 0 0 4.9-5.4l-2.6 2.6-2-2z" />
      </>
    )
  }
  {
    name === "plumbing" && (
      <>
        <path d="M4 4h6v6a4 4 0 0 0 4 4h6" />
        <circle cx="4" cy="4" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="20" cy="14" r="1.4" fill="currentColor" stroke="none" />
        <path d="M14 20v-6" />
      </>
    )
  }
  {
    name === "upvc" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="1" />
        <path d="M12 3v18M3 12h18" />
      </>
    )
  }
</svg>
